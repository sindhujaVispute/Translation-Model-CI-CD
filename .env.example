# Copy to .env (never commit .env). No credentials belong in this file.
# MLflow credentials, if your server needs them, are read by MLflow itself from the
# MLFLOW_TRACKING_USERNAME / MLFLOW_TRACKING_PASSWORD / MLFLOW_TRACKING_TOKEN
# environment variables - set those in your shell or secret store, not here.
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=translation-model-registration
MODEL_REGISTRY_NAME=translation-model
EVALUATION_DATASET_VERSION=v1

# Optional: translator factory for automatic BLEU, as package.module:callable
# TRANSLATOR_FACTORY=my_package.translation:create_translator
